# ---- Backend (FastAPI) ----
# Local default is a SQLite file in the backend folder. Docker Compose overrides this.
DATABASE_URL=sqlite:///./leadflow.db
# Comma-separated list of websites allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# ---- Frontend (Next.js) ----
# Address of the API as seen from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
